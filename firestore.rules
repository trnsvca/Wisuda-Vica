rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidWish() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.message is string && data.message.size() <= 1000
        && data.emoji is string && data.emoji.size() <= 32
        && (data.attendance == 'dateng' || data.attendance == 'usahakan' || data.attendance == 'doa');
    }

    match /wishes/{wishId} {
      allow read: if true;
      allow create: if isValidWish();
      allow update: if true;
      allow delete: if true;
    }

    match /gifts/{giftId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
